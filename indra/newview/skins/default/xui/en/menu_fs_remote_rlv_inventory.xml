<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<context_menu
 layout="topleft"
 name="Remote RLV Folder Context Menu">
  <menu_item_call
   label="Add Folder and Subfolders"
   name="add_folder">
    <menu_item_call.on_click
     function="RemoteRlv.AddFolder" />
  </menu_item_call>
  <menu_item_call
   label="Detach Folder and Subfolders"
   name="detach_folder">
    <menu_item_call.on_click
     function="RemoteRlv.DetachFolder" />
  </menu_item_call>
  <menu_item_separator />
  <menu_item_call
   label="Refresh Folder"
   name="refresh_folder">
    <menu_item_call.on_click
     function="RemoteRlv.RefreshFolder" />
  </menu_item_call>
</context_menu>

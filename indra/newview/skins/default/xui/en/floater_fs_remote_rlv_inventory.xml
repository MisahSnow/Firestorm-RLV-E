<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 can_close="true"
 can_minimize="true"
 can_resize="true"
 height="600"
 min_height="420"
 min_width="520"
 name="fs_remote_rlv_inventory"
 positioning="cascading"
 save_rect="true"
 save_visibility="false"
 single_instance="true"
 title="Remote RLV Wardrobe"
 width="640">
  <text
   follows="left|top"
   height="20"
   layout="topleft"
   left="10"
   name="target_label"
   top="14"
   width="52">
    Person:
  </text>
  <text
   follows="left|right|top"
   font.style="BOLD"
   height="20"
   layout="topleft"
   left_pad="4"
   name="target_name"
   parse_urls="false"
   top_delta="0"
   use_ellipses="true"
   value="No person selected"
   width="350" />
  <button
   follows="right|top"
   height="24"
   label="Choose Person..."
   layout="topleft"
   name="choose_target_btn"
   right="-96"
   top="9"
   width="124" />
  <button
   follows="right|top"
   height="24"
   label="Refresh"
   layout="topleft"
   name="refresh_btn"
   right="-10"
   top="9"
   width="80" />
  <text
   follows="left|right|top"
   height="38"
   layout="topleft"
   left="10"
   name="status_text"
   text_color="LabelTextColor"
   top="40"
   use_ellipses="true"
   value="Choose someone in the same region who is wearing an enabled RLV relay."
   width="620" />
  <tab_container
   follows="all"
   height="510"
   layout="topleft"
   left="8"
   name="remote_inventory_tabs"
   right="-8"
   tab_height="24"
   tab_min_width="150"
   tab_position="top"
   top="80">
    <panel
     follows="all"
     height="475"
     label="#RLV Folders"
     layout="topleft"
     name="folders_panel"
     top="0">
      <text
       follows="left|right|top"
       height="38"
       layout="topleft"
       left="8"
       name="folders_help"
       top="8"
       width="600">
        RLV exposes shared folder bundles, not the private items inside them. Expand a folder to load it, then add or detach the selected bundle.
      </text>
      <panel
       background_opaque="true"
       background_visible="true"
       bg_opaque_color="InventoryBackgroundColor"
       border="true"
       follows="all"
       layout="topleft"
       left="8"
       name="folder_tree_host"
       right="-8"
       top="48"
       bottom="-43" />
      <button
       follows="left|bottom"
       height="24"
       label="Add Folder"
       layout="topleft"
       left="8"
       name="add_folder_btn"
       bottom="-8"
       tool_tip="Add the selected folder and its subfolders without replacing other worn items."
       width="110" />
      <button
       follows="left|bottom"
       height="24"
       label="Detach Folder"
       layout="topleft"
       left_pad="6"
       name="detach_folder_btn"
       bottom_delta="0"
       tool_tip="Detach wearable contents in the selected folder and its subfolders."
       width="120" />
      <button
       follows="right|bottom"
       height="24"
       label="Refresh Folder"
       layout="topleft"
       name="refresh_folder_btn"
       right="-8"
       bottom_delta="0"
       width="112" />
    </panel>
    <panel
     follows="all"
     height="475"
     label="Attached"
     layout="topleft"
     name="attached_panel"
     top="0">
      <text
       follows="left|right|top"
       height="42"
       layout="topleft"
       left="8"
       name="attached_help"
       top="8"
       width="600">
        Shows worn #RLV folders and attachment objects visible to scripts. HUD names are private to Second Life and may appear only as an attachment point.
      </text>
      <scroll_list
       draw_heading="true"
       draw_stripes="true"
       follows="all"
       layout="topleft"
       left="8"
       multi_select="false"
       name="attached_list"
       right="-8"
       top="52"
       bottom="-43">
        <scroll_list.columns label="Type" name="type" width="92" />
        <scroll_list.columns dynamic_width="true" label="Name or #RLV path" name="name" />
        <scroll_list.columns label="Point" name="point" width="120" />
        <scroll_list.columns label="State" name="state" width="82" />
      </scroll_list>
      <button
       follows="left|bottom"
       height="24"
       label="Detach Selected"
       layout="topleft"
       left="8"
       name="detach_attached_btn"
       bottom="-8"
       width="130" />
      <button
       follows="right|bottom"
       height="24"
       label="Refresh Attached"
       layout="topleft"
       name="refresh_attached_btn"
       right="-8"
       bottom_delta="0"
       width="126" />
    </panel>
  </tab_container>
</floater>
